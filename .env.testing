# Config usada SÓ pelos testes automatizados (tests/bootstrap.php) — nunca
# aponta pro banco de produção. mecanize_db_test é uma cópia do schema (sem
# dados) de mecanize_db, criada com:
#   mysqldump -u root --no-data mecanize_db | mysql -u root mecanize_db_test
APP_DEBUG=true

DB_HOST=localhost
