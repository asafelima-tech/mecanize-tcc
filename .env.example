# true só em ambiente de desenvolvimento local — mostra o erro real na tela.
# Em produção, deixe "false" (ou remova a linha): erros viram uma página
# genérica e o detalhe vai só pro log do PHP.
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=mecanize_db
DB_USER=root
DB_PASS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-app-do-gmail
MAIL_FROM_NAME=Mecanize
MAIL_FROM_EMAIL=seu-email@gmail.com
MAIL_VERIFY_CERT=true
MAIL_CAFILE=C:\xampp\php\extras\ssl\cacert.pem

PLATE_RECOGNIZER_TOKEN=seu-token-do-platerecognizer.com
# A leitura é só uma SUGESTÃO: a pessoa confere antes de a placa entrar no cadastro. Cada leitura tem custo no plano
# contratado (há teto por sessão). Sem o token, o campo da placa é digitado normalmente.

# Consulta de dados do VEÍCULO pela placa (marca, modelo, ano, cor, combustível). Nenhum provedor é presumido: preencha
# conforme a DOCUMENTAÇÃO do serviço que a oficina contratar. Só dados do veículo atravessam (nunca dados do proprietário).
# Sem isto o botão "Buscar dados pela placa" nem aparece e o cadastro é manual.
# CONSULTA_PLACA_URL=https://api.do-seu-provedor.com/consulta/{placa}
# Tipo de autenticação: nenhum | bearer | cabecalho | consulta (token na URL)
# CONSULTA_PLACA_AUTH_TIPO=bearer
# Nome do cabeçalho/parâmetro, se o serviço usar um específico
# CONSULTA_PLACA_AUTH_NOME=
# CONSULTA_PLACA_TOKEN=
# Caminho que precisa ser verdadeiro na resposta, se o serviço tiver um campo de sucesso (opcional)
# CONSULTA_PLACA_CAMPO_SUCESSO=
# Caminho de cada campo no JSON da resposta (com pontos: dados.marca, itens.0.cor):
# CONSULTA_PLACA_CAMPO_MARCA=
# CONSULTA_PLACA_CAMPO_MODELO=
# Quando o serviço devolve marca e modelo juntos num campo só:
# CONSULTA_PLACA_CAMPO_MARCA_MODELO=
# CONSULTA_PLACA_CAMPO_ANO=
# CONSULTA_PLACA_CAMPO_ANO_MODELO=
# CONSULTA_PLACA_CAMPO_COR=
# CONSULTA_PLACA_CAMPO_COMBUSTIVEL=
# CONSULTA_PLACA_CAMPO_VERSAO=

# Papel timbrado dos documentos impressos (PDF de OS/orçamento, relatórios e
# impressão de qualquer tela). O que ficar em branco não é impresso.
EMPRESA_NOME=Mecanize
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_TELEFONE=
EMPRESA_EMAIL=
# Horário de atendimento mostrado ao cliente quando o veículo fica pronto (opcional).
EMPRESA_HORARIO=

# ── Portal do cliente, mensagens e pagamento online ───────────────────────────
# Nada aqui é obrigatório: sem estas variáveis o sistema funciona normalmente, as mensagens ao cliente
# ficam registradas nas conversas como "não enviadas" (o motivo aparece) e o pagamento é feito na oficina.
# A tela Integrações (administrador) mostra o que já está pronto e o que falta.

# Endereço público do sistema, sem barra final. Usado nos links enviados ao cliente e nas URLs de webhook.
# WhatsApp e provedores de pagamento só chamam webhook em HTTPS público.
APP_URL=
# Validade dos links do cliente (dias). O link pode ser revogado a qualquer momento na ficha do atendimento.
PORTAL_VALIDADE_DIAS=30

# WhatsApp Business Cloud API (oficial, da Meta). Exige conta Business, número, token e webhook público.
# Webhook: APP_URL/webhookWhatsApp  (verificação com WHATSAPP_VERIFY_TOKEN; corpo assinado com o App Secret)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANG=pt_BR
# Fora da janela de 24 h só vale template aprovado. Nome do template aprovado para cada aviso (parâmetros:
# {{1}} primeiro nome, {{2}} placa, {{3}} link). Sem o nome, a mensagem fora da janela fica registrada como não enviada.
# WHATSAPP_TEMPLATE_VEICULO_RECEBIDO=
# WHATSAPP_TEMPLATE_AVALIACAO_INICIADA=
# WHATSAPP_TEMPLATE_ORCAMENTO_DISPONIVEL=
# WHATSAPP_TEMPLATE_ORCAMENTO_APROVADO=
# WHATSAPP_TEMPLATE_ORCAMENTO_RECUSADO=
# WHATSAPP_TEMPLATE_SERVICO_INICIADO=
# WHATSAPP_TEMPLATE_AUTORIZACAO_ADICIONAL=
# WHATSAPP_TEMPLATE_PRONTO_RETIRADA=
# WHATSAPP_TEMPLATE_OS_CONCLUIDA=
# WHATSAPP_TEMPLATE_PAGAMENTO_CONFIRMADO=

# Pagamento online. PAGAMENTOS_PROVEDOR = mercadopago | simulado (simulado é SÓ para teste: não move dinheiro).
# Webhook: APP_URL/webhookPagamento  (toda notificação é conferida pela assinatura antes de qualquer efeito)
# Nenhum dado de cartão passa pelo Mecanize: o cliente paga na página do provedor.
PAGAMENTOS_PROVEDOR=
PAGAMENTOS_MAX_PARCELAS_CARTAO=1
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Só para teste local do fluxo (provedor simulado):
# PAGAMENTOS_PERMITIR_SIMULADO=true
# PAGAMENTOS_SIMULADO_SEGREDO=troque-por-um-segredo-longo-e-aleatorio

# Envio das mensagens pendentes: agende  php bin/enviar_mensagens.php  a cada minuto
# (Windows: Agendador de Tarefas; Linux: cron). Também sai ao fim das requisições da equipe.
